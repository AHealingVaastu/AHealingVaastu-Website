# Contact form email (Spacemail SMTP)
# Uses the email hosting that comes with your Spaceship domain, so no
# third-party email service is needed.
#
# The site logs in to a real Spacemail mailbox to send each booking email.
# An alias (such as bookings@) has no password of its own, so it cannot be
# SMTP_USER; it can only be the display "From" address via SMTP_FROM.

SMTP_HOST=mail.spacemail.com
SMTP_PORT=465

# The real mailbox the site logs in as, and its webmail password.
SMTP_USER=contact@ahealingvaastu.com
SMTP_PASSWORD=

# Optional: the address emails show as "from". Use an alias of SMTP_USER's
# mailbox. If Spacemail refuses to send from it, remove this line and emails
# will come from SMTP_USER instead.
SMTP_FROM=bookings@ahealingvaastu.com

# Inbox that receives booking requests. Can be the same as SMTP_USER.
CONTACT_TO_EMAIL=contact@ahealingvaastu.com

# Note: if SMTP_USER / SMTP_PASSWORD are not set, the API route still
# validates the submission and logs it to the server console (returns
# success), so the form works end-to-end in development without any
# secrets configured.
