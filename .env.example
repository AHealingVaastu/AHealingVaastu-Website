# ── Contact form email (Spacemail SMTP) ──────────────────────
# Uses the email hosting already included with your Spaceship domain —
# no third-party email service needed.
#
# 1. In Spaceship, create (or use an existing) mailbox on your domain,
#    e.g. bookings@ahealingvaastu.com — this is the account that will send
#    the notification emails.
# 2. Fill in its address and password below.

SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=bookings@ahealingvaastu.com
SMTP_PASSWORD=

# Optional: only set this if SMTP_USER (above) is the account you log in
# with, but you want emails to display as being sent "from" a different
# alias on the same mailbox. Leave unset to just use SMTP_USER for both.
# SMTP_FROM=bookings@ahealingvaastu.com

# Address bookings are sent TO (the inbox that should receive leads).
# Can be the same address as SMTP_USER, or a different mailbox.
CONTACT_TO_EMAIL=contact@ahealingvaastu.com

# Note: if SMTP_USER / SMTP_PASSWORD are not set, the API route still
# validates the submission and logs it to the server console (returns
# success), so the form works end-to-end in development without any
# secrets configured.
